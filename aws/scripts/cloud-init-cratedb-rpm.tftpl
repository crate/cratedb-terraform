#cloud-config

package_update: true
package_upgrade: true
package_reboot_if_required: true

yum_repos:
  cratedb:
    baseurl: https://cdn.crate.io/downloads/yum/7/$basearch
    enabled: true
    gpgcheck: true
    gpgkey: https://cdn.crate.io/downloads/yum/RPM-GPG-KEY-crate
    type: rpm-md
    autorefresh: true
    name: CrateDB stable releases

packages:
  - tar
  - openssl
  - htop
  - jq
  - nano

bootcmd:
  - test -z "$(blkid /dev/sdh)" && mkfs -t xfs -L data /dev/sdh
  - mkdir -m 777 /opt/data
  - mount LABEL=data /opt/data

mounts:
  - ["LABEL=data", "/opt/data", "xfs", "defaults,noexec,nofail"]

write_files:
  - content: |
      [Unit]
      Description=Prometheus Node Exporter
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=simple
      User=node_exporter
      Group=node_exporter
      ExecStart=/usr/local/bin/node_exporter
      Restart=on-failure
      RestartSec=5s

      [Install]
      WantedBy=multi-user.target
    path: /etc/systemd/system/node_exporter.service
    permissions: "0644"
  - content: !!binary |
      ${crate_ssl_private_key}
    path: /etc/crate/private_key.pem
    permissions: "0660"
  - content: !!binary |
      ${crate_ssl_certificate}
    path: /etc/crate/certificate.pem
    permissions: "0660"
  - content: |
      ${user_provisioning_file}
    owner: root:root
    path: /opt/deployment/user_provisioning.sh
    permissions: "0755"
  - content: |
        path.data: /opt/data

        auth.host_based.enabled: true
        auth:
          host_based:
            config:
              0:
                user: crate
                address: _local_
                method: trust
              99:
                method: password

        network.host: _site_, _local_

        discovery.seed_hosts:
            ${crate_nodes_ips}

        cluster.name: ${crate_cluster_name}
        cluster.initial_master_nodes:
            ${crate_nodes_ips}

        node.name: ${crate_node_name}

        gateway.expected_data_nodes: ${crate_cluster_size}
        gateway.recover_after_data_nodes: ${crate_cluster_size}

        ssl.http.enabled: ${crate_ssl_enable ? "true" : "false"}
        ssl.psql.enabled: ${crate_ssl_enable ? "true" : "false"}
        ssl.keystore_filepath: /etc/crate/keystore.p12
        ssl.keystore_password: changeit
        ssl.keystore_key_password: changeit

        ${cratedb_user_settings}
    owner: root:root
    path: /etc/crate/crate.yml
    permissions: "0755"
  - content: |
      # Recommended memory settings for production:
      # - assign half of the OS memory to CrateDB
      #   (e.g. 26g, stay below ~30G to benefit from CompressedOops)
      # - disable swapping my setting bootstrap.mlockall in crate.yml
      # Heap Size (defaults to 256m min, 1g max)
      CRATE_HEAP_SIZE=${crate_heap_size}

      # Additional Java options
      CRATE_JAVA_OPTS="-javaagent:/usr/share/crate/crate-jmx-exporter-${jmx_exporter_version}.jar=8080%{if pyroscope_server != ""} -javaagent:/usr/share/crate/pyroscope.jar%{endif}"

      %{if pyroscope_server != ""}
      PYROSCOPE_APPLICATION_NAME=${crate_node_name}
      PYROSCOPE_SERVER_ADDRESS=${pyroscope_server}
      PYROSCOPE_PROFILER_ALLOC=512k
      %{endif}
    owner: root:root
    path: /etc/default/crate
    permissions: "0755"
  - content: |
      # Certain load balancers (i.e. AWS NLB) terminate idle connections.
      # We set explicit TCP keepalives so that this does not happen.
      # https://github.com/crate/crate-operator/commit/383c5f4795e58fe1a61fab0cfdfba4e294953f9f
      net.ipv4.tcp_keepalive_time = 120
      net.ipv4.tcp_keepalive_intvl = 30
      net.ipv4.tcp_keepalive_probes = 6
    owner: root:root
    path: /etc/sysctl.d/90-crate-net.conf
    permissions: "0644"

runcmd:
  - sysctl -p /etc/sysctl.d/90-crate-net.conf
  - openssl pkcs12 -export -in /etc/crate/certificate.pem -inkey /etc/crate/private_key.pem -certfile /etc/crate/certificate.pem -out /etc/crate/keystore.p12 -passout pass:changeit
  - rm /etc/crate/certificate.pem && rm /etc/crate/private_key.pem
  - dnf install -y crate
  - chown -R crate:crate /opt/data /etc/crate
  - chmod 700 /opt/data
  - curl --output-dir /usr/share/crate -O https://repo1.maven.org/maven2/io/crate/crate-jmx-exporter/${jmx_exporter_version}/crate-jmx-exporter-${jmx_exporter_version}.jar
  - curl --output-dir /usr/share/crate -O https://github.com/grafana/pyroscope-java/releases/download/v${pyroscope_version}/pyroscope.jar
  - systemctl enable crate
  - systemctl start crate
  - bash /opt/deployment/user_provisioning.sh "${crate_protocol}" "${crate_user}" "${crate_pass}" && rm -f /opt/deployment/user_provisioning.sh
  - |
    set -eu
    case "$(uname -m)" in
      x86_64) archive_arch=amd64 ;;
      aarch64) archive_arch=arm64 ;;
      *) echo "Unsupported node_exporter architecture: $(uname -m)" >&2; exit 1 ;;
    esac
    install_dir=$(mktemp -d /var/tmp/node-exporter-install.XXXXXX)
    trap 'rm -rf "$install_dir"' EXIT
    curl --fail --location --retry 3 -o "$install_dir/node_exporter.tar.gz" "https://github.com/prometheus/node_exporter/releases/download/v${node_exporter_version}/node_exporter-${node_exporter_version}.linux-$archive_arch.tar.gz"
    tar -xzf "$install_dir/node_exporter.tar.gz" -C "$install_dir"
    install -m 0755 "$install_dir/node_exporter-${node_exporter_version}.linux-$archive_arch/node_exporter" /usr/local/bin/node_exporter
    id node_exporter >/dev/null 2>&1 || useradd --system --user-group --no-create-home --shell /sbin/nologin node_exporter
    systemctl daemon-reload
    systemctl enable --now node_exporter.service

final_message: "The system is finally up, after $UPTIME seconds"
