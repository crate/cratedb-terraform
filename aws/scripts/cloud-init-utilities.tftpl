#cloud-config

package_update: true
package_upgrade: true
package_reboot_if_required: true

packages:
  - tar
  - git
  - tmux
  - htop
  - nano
  - python3-pip
  # Required by nodejs
  - libatomic

write_files:
  - content: |
      #!/bin/bash

      # Ensure ec2-user is already present
      until [[ $(getent passwd ec2-user) ]]
      do
          sleep 5
      done

      sudo -i -u ec2-user bash << EOF
        curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.41.0/install.sh | bash
        source ~/.bashrc

        nvm install node --latest-npm

        git clone https://github.com/proddata/nodeIngestBench.git

        cd ~/nodeIngestBench
        npm install

        pip3 install locust
      EOF
    owner: root:root
    path: /root/node.sh
    permissions: "0755"
  - content: |
      CRATE_USER="${crate_user}"
      CRATE_HOST="${crate_host}"
      CRATE_PASSWORD="${crate_password}"
      CRATE_SSL="${crate_ssl ? "true" : "false"}"
    path: /root/.env
  - content: !!binary |
      ${ssl_private_key}
    path: /etc/private_key.pem
    permissions: "0666"
  - content: !!binary |
      ${ssl_certificate}
    path: /etc/certificate.pem
    permissions: "0666"
  - content: |
      global:
        scrape_interval:     5s # Set the scrape interval to every 5 seconds. Default is every 1 minute.
        evaluation_interval: 5s # Evaluate rules every 5 seconds. The default is every 1 minute.

      scrape_configs:
        - job_name: cratedb
          static_configs:
            - targets:
                ${jmx_targets}

        - job_name: node_exporter
          static_configs:
            - targets:
                ${node_exporter_targets}

        - job_name: sql_exporter
          # Preserve Prometheus 2 behavior for exporters without a valid Content-Type.
          fallback_scrape_protocol: PrometheusText0.0.4
          static_configs:
            - targets:
                - "localhost:9399"
    path: /etc/prometheus/prometheus.yml
  - content: |
      ${sql_exporter_config}
    path: /etc/prometheus/sql_exporter.yml
  - content: |
      collector_name: cratedb_standard

      metrics:
        - metric_name: shard_distribution
          type: gauge
          help: "Number of shards per node"
          key_labels: [node_name]
          values: [shards]
          query: |
            SELECT node['name'] AS node_name, COUNT(*) AS shards
            FROM sys.shards
            GROUP BY 1;
    path: /etc/prometheus/cratedb_standard.collector.yml
  - content: |
      ${prometheus_config}
    path: /etc/prometheus/web.yml
  - content: |
      [Unit]
      Description=Prometheus
      Documentation=https://prometheus.io/docs/
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=simple
      User=prometheus
      Group=prometheus
      ExecStartPre=/usr/local/bin/promtool check config /etc/prometheus/prometheus.yml
      ExecStart=/usr/local/bin/prometheus \
        --config.file=/etc/prometheus/prometheus.yml \
        --storage.tsdb.path=/var/lib/prometheus/data \
        --web.config.file=/etc/prometheus/web.yml
      ExecReload=/bin/kill -HUP $MAINPID
      Restart=on-failure
      RestartSec=5s

      [Install]
      WantedBy=multi-user.target
    path: /etc/systemd/system/prometheus.service
    permissions: "0644"
  - content: |
      [Unit]
      Description=SQL Exporter
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=simple
      User=sql_exporter
      Group=sql_exporter
      WorkingDirectory=/etc/prometheus
      ExecStart=/usr/local/bin/sql_exporter --config.file=/etc/prometheus/sql_exporter.yml
      Restart=on-failure
      RestartSec=5s

      [Install]
      WantedBy=multi-user.target
    path: /etc/systemd/system/sql_exporter.service
    permissions: "0644"

runcmd:
  - /root/node.sh
  - mv /root/.env /home/ec2-user/nodeIngestBench/.env
  - chown ec2-user:ec2-user /home/ec2-user/nodeIngestBench/.env
  - |
    set -eu
    case "$(uname -m)" in
      x86_64) archive_arch=amd64 ;;
      aarch64) archive_arch=arm64 ;;
      *) echo "Unsupported Prometheus architecture: $(uname -m)" >&2; exit 1 ;;
    esac
    install_dir=$(mktemp -d /var/tmp/prometheus-install.XXXXXX)
    trap 'rm -rf "$install_dir"' EXIT
    curl --fail --location --retry 3 -o "$install_dir/prometheus.tar.gz" "https://github.com/prometheus/prometheus/releases/download/v${prometheus_version}/prometheus-${prometheus_version}.linux-$archive_arch.tar.gz"
    tar -xzf "$install_dir/prometheus.tar.gz" -C "$install_dir"
    install -m 0755 "$install_dir/prometheus-${prometheus_version}.linux-$archive_arch/prometheus" /usr/local/bin/prometheus
    install -m 0755 "$install_dir/prometheus-${prometheus_version}.linux-$archive_arch/promtool" /usr/local/bin/promtool
    id prometheus >/dev/null 2>&1 || useradd --system --user-group --home-dir /var/lib/prometheus --shell /sbin/nologin prometheus
    install -d -o prometheus -g prometheus -m 0755 /var/lib/prometheus/data

    curl --fail --location --retry 3 -o "$install_dir/sql_exporter.tar.gz" "https://github.com/burningalchemist/sql_exporter/releases/download/${sql_exporter_version}/sql_exporter-${sql_exporter_version}.linux-$archive_arch.tar.gz"
    tar -xzf "$install_dir/sql_exporter.tar.gz" -C "$install_dir"
    install -m 0755 "$install_dir/sql_exporter-${sql_exporter_version}.linux-$archive_arch/sql_exporter" /usr/local/bin/sql_exporter
    id sql_exporter >/dev/null 2>&1 || useradd --system --user-group --no-create-home --shell /sbin/nologin sql_exporter
    chown root:sql_exporter /etc/prometheus/sql_exporter.yml
    chmod 0640 /etc/prometheus/sql_exporter.yml

    systemctl daemon-reload
    systemctl enable --now prometheus.service sql_exporter.service
